<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>InventorDxfExporter</AssemblyName>
    <RootNamespace>InventorDxfExporter</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <InventorBinPath Condition="'$(InventorBinPath)' == ''">C:\Program Files\Autodesk\Inventor 2027\Bin</InventorBinPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="Preview\**\*.cs" />
    <Compile Remove="Skill\**\*.cs" />
    <Compile Remove="Tests\DxfProcessorValidation\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorBinPath)\Autodesk.Inventor.Interop.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.iLogic.Interfaces">
      <HintPath>$(InventorBinPath)\Autodesk.iLogic.Interfaces.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="stdole">
      <HintPath>$(InventorBinPath)\stdole.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Update="Examples\Doi_K_Factor_Assembly.vb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Doi_K_Factor_Assembly.vb</TargetPath>
    </None>
  </ItemGroup>
</Project>
