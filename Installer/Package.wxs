<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="Inventor DXF Exporter Pro"
    Manufacturer="PiDiDii"
    Version="$(var.ProductVersion)"
    UpgradeCode="{C95E6FF4-13D3-4AD4-85C4-09F929F2244E}"
    Scope="perUser"
    InstallerVersion="500">
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Inventor DXF Exporter Pro is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_Minimal" />
    <Feature Id="Main" Title="Inventor DXF Exporter Pro" Level="1">
      <ComponentGroupRef Id="AddinFiles" />
      <ComponentRef Id="UninstallShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="AppDataFolder">
      <Directory Id="AutodeskFolder" Name="Autodesk">
        <Directory Id="InventorFolder" Name="Inventor 2027">
          <Directory Id="AddinsFolder" Name="Addins" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Inventor DXF Exporter Pro">
        <Component Id="UninstallShortcut" Guid="{07D1527F-7CE1-4D64-AC90-768E5D48A1F1}">
          <Shortcut
            Id="UninstallStartMenuShortcut"
            Name="Uninstall Inventor DXF Exporter Pro"
            Target="[SystemFolder]msiexec.exe"
            Arguments="/x [ProductCode]" />
          <RegistryValue
            Root="HKCU"
            Key="Software\PiDiDii\InventorDxfExporter"
            Name="UninstallShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Fragment>
</Wix>
