<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Inventor2027Addin</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InventorBinPath Condition="'$(InventorBinPath)' == ''">C:\Program Files\Autodesk\Inventor 2027\Bin</InventorBinPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorBinPath)\Autodesk.Inventor.Interop.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <None Update="Inventor2027Addin.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
